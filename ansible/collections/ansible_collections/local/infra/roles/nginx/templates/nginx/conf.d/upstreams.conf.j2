# 此文件由 Ansible 管理，请勿手动修改，任何手动更改都将被覆盖。

{% for item in nginx_upstreams_default | combine(nginx_upstreams) | dict2items %}
upstream {{ item.key }} {
  {% if item.value is number %}
  server 127.0.0.1:{{ item.value }};
  {% else %}
  server {{ item.value }};
  {% endif %}
  keepalive 32;
}
{% endfor %}
