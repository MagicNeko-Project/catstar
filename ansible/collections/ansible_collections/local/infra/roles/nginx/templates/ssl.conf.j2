# 此文件由 Ansible 管理，请勿手动修改，任何手动更改都将被覆盖。

{% if item.stat.exists %}
ssl_certificate {{ nginx_ssl_root }}/{{ item.item }}/full.pem;
ssl_certificate_key {{ nginx_ssl_root }}/{{ item.item }}/key.pem;
{% else %}
ssl_certificate {{ nginx_ssl_root }}/_/full.pem;
ssl_certificate_key {{ nginx_ssl_root }}/_/key.pem;
{% endif %}
