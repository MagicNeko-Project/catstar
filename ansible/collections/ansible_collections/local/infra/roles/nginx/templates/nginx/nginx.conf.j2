# 此文件由 Ansible 管理，请勿手动修改，任何手动更改都将被覆盖。

user                 {{ nginx_user }};
worker_processes     auto;
worker_rlimit_nofile 65535;

# Load modules
include              modules-enabled/*.conf;

events {
    multi_accept       on;
    worker_connections 65535;
}

http {
    charset                utf-8;
    sendfile               on;
    tcp_nopush             on;
    tcp_nodelay            on;
    server_tokens          off;
    log_not_found          off;
    types_hash_max_size    2048;
    types_hash_bucket_size 64;
    client_max_body_size   16M;

    # MIME
    include                mime.types;
    default_type           application/octet-stream;

    # Log Format
    log_format             cloudflare '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" $http_cf_ray $http_cf_connecting_ip $http_x_forwarded_for $http_x_forwarded_proto';

    # Logging
    access_log             syslog:server=unix:/dev/log cloudflare;
    error_log              syslog:server=unix:/dev/log warn;

    # TLS
    ssl_session_timeout    1d;
    ssl_session_cache      shared:SSL:10m;

    {% if nginx_mozilla_ssl | lower == 'modern' %}
    ssl_protocols          TLSv1.3;
    {% else %}
    ssl_protocols          TLSv1.2 TLSv1.3;
    ssl_ciphers            ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    {% endif %}
    ssl_prefer_server_ciphers off;

    # DNS Resolver
    resolver               1.1.1.1 1.0.0.1 [2606:4700:4700::1111] [2606:4700:4700::1001] 8.8.8.8 8.8.4.4 valid=60s;
    resolver_timeout       2s;

    # Load configs
    include                conf.d/*.conf;
    include                {{ nginx_sites_enabled_dir }}/*;
    include                cloudflare;
}

{% if nginx_stream | length %}
stream {
    include conf.d/stream;
    include conf.d/*.streamconf;
}
{% endif %}
