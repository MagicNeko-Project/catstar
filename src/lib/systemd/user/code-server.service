# Note: There are 3 variants of this unit file:
# 1. code-server.service (user unit, user-local installation)
# 2. code-server-system.service (user unit, system installation)
# 3. code-server@.service (system unit, system-wide running as specific user)

[Unit]
Description=code-server (for user)
After=network.target

[Service]
WorkingDirectory=%h
ExecStart=%h/.local/bin/code-server
Type=simple
NoNewPrivileges=yes
Restart=always

[Install]
WantedBy=default.target
